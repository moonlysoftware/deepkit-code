+        let ids = |hits: Vec<FtsHit>| hits.into_iter().map(|hit| hit.unit_id).collect::<Vec<_>>();
+        assert_eq!(
+            ids(relax(Arm(3), hits(&[4]), hits(&[1, 4, 2]))),
