+fn read_query_fts_candidate_matches(
+    connection: &Connection,
+    queries: &[String],
+    candidates: &[i64],
+    scope: Option<&SearchScope>,
+    exclude_ids: &[i64],
+    check: &dyn Fn() -> Result<(), Error>,
+) -> Result<Vec<BTreeSet<i64>>, Error> {
+    check()?;
+    let projection::Exclusions { prefix, predicate } = projection::exclusion_sql(exclude_ids, 4);
+    let scope_sql = projection::scope_sql(SEARCH_SCOPE_SQL);
+    let mut statement = connection.prepare(&format!(
+        "{prefix}SELECT u.id FROM fts_units
+         JOIN units u ON u.id = fts_units.rowid
+         LEFT JOIN files f ON f.id = u.file_id
+         WHERE fts_units MATCH ?1
+           AND u.id IN (SELECT value FROM json_each(?2))
+           AND (?3 IS NULL OR {scope_sql}) AND {predicate}
+         ORDER BY u.id"
+    ))?;
+    let candidates = serde_json::json!(candidates).to_string();
+    let excluded = serde_json::json!(exclude_ids).to_string();
+    let mut matches = Vec::with_capacity(queries.len());
+    for query in queries {
+        check()?;
+        let mut ids = BTreeSet::new();
+        if !query.is_empty() {
+            let mut rows = statement.query(params![query, &candidates, scope, &excluded])?;
+            loop {
+                check()?;
+                let Some(row) = rows.next()? else { break };
+                ids.insert(row.get(0)?);
+            }
+        }
+        matches.push(ids);
+    }
+    check()?;
+    Ok(matches)
+}
