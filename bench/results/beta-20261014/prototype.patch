+//! Isolated, non-shipping lexical hypotheses for the 2026-09-25 research run.
+//! The default arm preserves v1 §9; each other arm is independent, not cumulative.
+
+use std::collections::BTreeSet;
+
+use super::Error;
+use crate::{
+    store::FtsHit,
+    treat::fts::{build_match, build_or_match, column_identifier_clause, query_clauses},
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Arm(u8);
+
+impl Arm {
+    /// Reads the research switch without changing configuration or database bytes.
+    pub(super) fn current(plain: bool, query: &str, identifiers: &[String]) -> Self {
+        let requested = std::env::var("DKC_SEARCH_EXPERIMENT")
+            .ok()
+            .and_then(|value| value.parse::<u8>().ok())
+            .unwrap_or(0);
+        // Frozen before scores: natural text has at least two lexical words and
+        // one non-identifier word. Standalone names and identifier-only queries
+        // keep baseline behavior except arm 3's rank-only rule. All arms bypass
+        // typed or quoted queries so the frozen ordered-identity controls hold.
+        Self::selected(requested, plain, natural_text(query, identifiers))
+    }
+
+    fn selected(requested: u8, plain: bool, natural: bool) -> Self {
+        if requested <= 9 && plain && (natural || requested == 3) {
+            Self(requested)
+        } else {
+            Self(0)
+        }
+    }
+}
+
+fn words(query: &str) -> Vec<&str> {
+    query
+        .split(|ch: char| !(ch.is_alphanumeric() || matches!(ch, '_' | '$' | '.')))
+        .filter(|word| !word.is_empty())
+        .collect()
+}
+
+fn natural_text(query: &str, identifiers: &[String]) -> bool {
+    let words = words(query);
+    words.len() >= 2
+        && words.iter().any(|word| {
+            !identifiers
+                .iter()
+                .any(|identifier| identifier.as_str() == *word)
+        })
+}
+
+fn strip_framing(query: &str) -> String {
+    let words = query.split_whitespace().collect::<Vec<_>>();
+    let remove = match words.as_slice() {
+        [first, second, ..]
+            if (first.eq_ignore_ascii_case("where")
+                && ["is", "does", "are"].contains(&second.to_ascii_lowercase().as_str()))
+                || (first.eq_ignore_ascii_case("how")
+                    && ["do", "does", "are"].contains(&second.to_ascii_lowercase().as_str())) =>
+        {
+            2
+        }
+        [first, ..]
+            if first.eq_ignore_ascii_case("which") || first.eq_ignore_ascii_case("what") =>
+        {
+            1
+        }
+        _ => 0,
+    };
+    let stripped = words[remove..].join(" ");
+    if build_match(&stripped).is_empty() {
+        query.to_owned()
+    } else {
+        stripped
+    }
+}
+
+fn distinct(clauses: Vec<String>) -> Vec<String> {
+    let mut seen = BTreeSet::new();
+    clauses
+        .into_iter()
+        .filter(|clause| seen.insert(clause.to_lowercase()))
+        .collect()
+}
+
+fn grammatical(word: &str) -> bool {
+    matches!(
+        word.to_ascii_lowercase().as_str(),
+        "a" | "an"
+            | "the"
+            | "is"
+            | "are"
+            | "was"
+            | "were"
+            | "be"
+            | "been"
+            | "being"
+            | "do"
+            | "does"
+            | "did"
+            | "can"
+            | "could"
+            | "would"
+            | "should"
+            | "where"
+            | "which"
+            | "what"
+            | "how"
+    )
+}
+
+/// Builds the independent arm's strict/relaxed expressions; dense text is untouched.
+pub(super) fn matches(arm: Arm, query: &str, identifiers: &[String]) -> (String, String) {
+    match arm.0 {
+        1 => {
+            let text = strip_framing(query);
+            (build_match(&text), build_or_match(&text))
+        }
+        2 => {
+            let clauses = distinct(query_clauses(query));
+            (clauses.join(" AND "), clauses.join(" OR "))
+        }
+        4 if !identifiers.is_empty() => {
+            let clauses = words(query)
+                .into_iter()
+                .flat_map(|word| {
+                    if identifiers
+                        .iter()
+                        .any(|identifier| identifier.as_str() == word)
+                    {
+                        vec![column_identifier_clause(word)]
+                    } else {
+                        query_clauses(word)
+                    }
+                })
+                .filter(|clause| !clause.is_empty())
+                .collect::<Vec<_>>();
+            (clauses.join(" AND "), clauses.join(" OR "))
+        }
+        9 => {
+            let content = words(query)
+                .into_iter()
+                .filter(|word| !grammatical(word))
+                .collect::<Vec<_>>()
+                .join(" ");
+            let relaxed = build_or_match(&content);
+            (
+                build_match(query),
+                if relaxed.is_empty() {
+                    build_or_match(query)
+                } else {
+                    relaxed
+                },
+            )
+        }
+        _ => (build_match(query), build_or_match(query)),
+    }
+}
+
+/// Arm 3 alone preserves strict rank before appending unseen relaxed occurrences.
+pub(super) fn relax(arm: Arm, mut strict: Vec<FtsHit>, relaxed: Vec<FtsHit>) -> Vec<FtsHit> {
+    if arm.0 != 3 || strict.is_empty() {
+        return relaxed;
+    }
+    let mut seen = strict
+        .iter()
+        .map(|hit| hit.unit_id)
+        .collect::<BTreeSet<_>>();
+    strict.extend(relaxed.into_iter().filter(|hit| seen.insert(hit.unit_id)));
+    strict.truncate(super::LEXICAL_LIMIT);
+    strict
+}
+
+fn phrase_clause(query: &str, identifiers: &[String]) -> Option<String> {
+    let words = words(query);
+    let phrases = words
+        .windows(2)
+        .filter(|pair| {
+            !pair.iter().any(|word| {
+                identifiers
+                    .iter()
+                    .any(|identifier| identifier.as_str() == *word)
+                    || word.contains(['_', '$', '.'])
+            })
+        })
+        .map(|pair| format!("\"{} {}\"", pair[0], pair[1]))
+        .collect::<Vec<_>>();
+    (!phrases.is_empty()).then(|| phrases.join(" OR "))
+}
+
+fn anchor_clause(query: &str, identifiers: &[String]) -> Option<String> {
+    let mixed = !identifiers.is_empty()
+        && words(query).iter().any(|word| {
+            !identifiers
+                .iter()
+                .any(|identifier| identifier.as_str() == *word)
+        });
+    mixed.then(|| {
+        identifiers
+            .iter()
+            .map(|identifier| format!("({})", build_match(identifier)))
+            .collect::<Vec<_>>()
+            .join(" OR ")
+    })
+}
+
+/// Reorders admitted candidates by a fixed key, retaining baseline BM25 ties.
+/// Membership comes from FTS itself, scoped and bounded to these candidate IDs.
+pub(super) fn rank(
+    arm: Arm,
+    query: &str,
+    identifiers: &[String],
+    fallback: bool,
+    lexical: &mut [FtsHit],
+    membership: impl FnOnce(&[String], &[i64]) -> Result<Vec<BTreeSet<i64>>, Error>,
+) -> Result<(), Error> {
+    if lexical.is_empty() {
+        return Ok(());
+    }
+    let clauses = match arm.0 {
+        5 if fallback => distinct(query_clauses(&strip_framing(query))),
+        6 => phrase_clause(query, identifiers).into_iter().collect(),
+        7 if fallback => anchor_clause(query, identifiers).into_iter().collect(),
+        _ => Vec::new(),
+    };
+    if clauses.is_empty() {
+        return Ok(());
+    }
+    let candidates = lexical.iter().map(|hit| hit.unit_id).collect::<Vec<_>>();
+    let matching = membership(&clauses, &candidates)?;
+    lexical.sort_by_cached_key(|hit| {
+        std::cmp::Reverse(
+            matching
+                .iter()
+                .filter(|ids| ids.contains(&hit.unit_id))
+                .count(),
+        )
+    });
+    Ok(())
+}
+
+/// Arm 8 skips graph votes only for untyped, unquoted text without explicit names.
+pub(super) fn disable_graph(arm: Arm, identifiers: &[String]) -> bool {
+    arm.0 == 8 && identifiers.is_empty()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
