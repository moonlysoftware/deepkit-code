+        let scope = crate::store::SearchScope::from("src/*");
+        let checked = std::cell::Cell::new(0);
+        let check = || {
+            checked.set(checked.get() + 1);
+            Ok(())
+        };
+        assert_eq!(
+            store.query_fts_candidate_matches_checked(
+                &queries,
+                &[first, other],
+                Some(&scope),
+                &[],
+                &check
+            )?,
+            vec![BTreeSet::from([first]), BTreeSet::from([first])]
+        );
+        assert!(checked.get() > 3);
+        assert_eq!(
+            store.query_fts_candidate_matches(&queries, &[first, other], Some(&scope), &[first])?,
+            vec![BTreeSet::new(), BTreeSet::new()]
+        );
+        assert!(
+            store
+                .query_fts_candidate_matches_checked(&queries, &[first], None, &[], &|| Err(
+                    crate::store::Error::L1InputsChanged
+                ))
+                .is_err()
+        );
+        Ok(())
+    }
+}
