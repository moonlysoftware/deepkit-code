+    #[test]
+    fn routing_guards_preserve_dense_text_and_typed_quoted_rank() -> Result<(), Box<dyn StdError>> {
+        for text in [
+            "lex:Where is RetryPolicy",
+            "\"Where is RetryPolicy\"",
+            "vec:vague lex:retry",
+        ] {
+            let parsed = super::super::query::parse(text, Mode::Hybrid)?;
+            assert!(!parsed.experimental_plain);
+            for number in 1..=9 {
+                assert_eq!(Arm::selected(number, parsed.experimental_plain, true).0, 0);
+            }
+        }
+        let parsed = super::super::query::parse("Where is RetryPolicy", Mode::Hybrid)?;
+        assert!(parsed.experimental_plain);
+        let rewritten = matches(
+            Arm(1),
+            parsed.lexical.as_deref().unwrap_or_default(),
+            &parsed.ident_terms,
+        );
+        assert_eq!(rewritten.0, build_match("RetryPolicy"));
+        assert_eq!(parsed.dense.as_deref(), Some("Where is RetryPolicy"));
+        assert_eq!(Arm::selected(10, true, true), Arm(0));
+        assert_eq!(Arm::selected(3, true, false), Arm(3));
+        Ok(())
+    }
+
+    #[test]
+    fn independent_query_arms_have_frozen_rules_and_safe_empty_fallbacks() {
+        for prefix in [
+            "Where is",
+            "Where does",
+            "Where are",
+            "How do",
+            "How does",
+            "How are",
+            "Which",
+            "What",
+        ] {
+            assert_eq!(
+                matches(Arm(1), &format!("{prefix} retry policy"), &[]).0,
+                build_match("retry policy")
+            );
+        }
+        assert_eq!(
+            matches(Arm(1), "where was retry policy", &[]).0,
+            build_match("where was retry policy")
+        );
+        assert_eq!(matches(Arm(1), "Where is", &[]).0, build_match("Where is"));
+        assert_eq!(
+            matches(Arm(2), "retry Retry policy retry", &[]).0,
+            build_match("retry policy")
+        );
+        assert_eq!(
+            matches(Arm(4), "RetryPolicy from policy", &["RetryPolicy".into()]).0,
+            "(idents:\"RetryPolicy\" OR body:(\"retry\" AND \"policy\")) AND \"from\" AND \"policy\""
+        );
+        assert_eq!(
+            matches(Arm(9), "Where is the retry not from to without policy", &[]),
+            (
+                build_match("Where is the retry not from to without policy"),
+                build_or_match("retry not from to without policy")
+            )
+        );
+        assert_eq!(
+            matches(Arm(9), "where is the", &[]).1,
+            build_or_match("where is the")
+        );
+        assert_eq!(
+            matches(Arm(0), "RetryPolicy retry retry", &["RetryPolicy".into()]),
+            (
+                build_match("RetryPolicy retry retry"),
+                build_or_match("RetryPolicy retry retry")
+            )
+        );
+    }
